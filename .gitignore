# =====================================================
# Environment files (NUNCA commitar — contém segredos)
#  - .env / .env.* / *.env são ignorados
#  - .env.example NÃO é ignorado (template público)
#  - 'env', 'env (1)' etc. (downloads sujos sem extensão) são ignorados
# =====================================================
.env
.env.*
*.env
!.env.example
env
env\ *
"env (*)"

