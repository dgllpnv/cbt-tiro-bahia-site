# =====================================================
# CBT — Backend (.env.example)
# Copie este arquivo para `.env` antes de rodar.
# Em DEV o script start-dev.ps1 / start-dev.sh cria
# automaticamente um `.env` com estes valores se não existir.
# =====================================================

# PostgreSQL — sobe via docker-compose (cbt-postgres na porta 5434).
DATABASE_URL=postgresql://postgres:cbt_dev_2024@localhost:5434/cbt_portal
DIRECT_URL=postgresql://postgres:cbt_dev_2024@localhost:5434/cbt_portal

# JWT — em PRODUÇÃO troque por segredo aleatório (gere com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=cbt-dev-jwt-secret-key-change-in-production-2024
JWT_EXPIRES_IN=7d

# API
PORT=3002
NODE_ENV=development

# CORS — domínios permitidos (separados por vírgula).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174
