{
  "name": "cbt-backend",
  "version": "1.0.0",
  "description": "CBT - Clube Baiano de Tiro - Portal Backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start:prod": "tsx src/index.ts",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:news-events": "tsx prisma/seed-news-events.ts",
    "db:seed:financial": "tsx prisma/seed-financial.ts",
    "db:seed:gallery": "tsx prisma/seed-gallery.ts",
    "db:seed:all": "npm run db:seed && npm run db:seed:demo && npm run db:seed:news-events && npm run db:seed:financial && npm run db:seed:gallery",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && npm run db:seed:all",
    "test:annuity": "tsx scripts/test-annuity-cycle.ts",
    "fix:anuidade": "tsx scripts/fix-annuity-anniversary.ts",
    "fix:anuidade:apply": "tsx scripts/fix-annuity-anniversary.ts --apply",
    "migrate:adm:dry-run": "tsx scripts/migrate-adm-clube.ts --dry-run",
    "migrate:adm:apply": "tsx scripts/migrate-adm-clube.ts --apply",
    "migrate:adm:cleanup": "tsx scripts/migrate-adm-clube.ts --cleanup-only"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "iconv-lite": "^0.6.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
